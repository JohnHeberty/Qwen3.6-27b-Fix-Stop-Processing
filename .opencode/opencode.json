{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Gateway",
      "options": {
        "baseURL-LOCAL": "http://192.168.1.139:11434/v1",
        "baseURL-OLLAMA": "http://100.102.127.47:11434/v1",
        "baseURL": "http://100.91.54.69:4000/v1",
        "apiKey": "sk-litellm-master"
      },
      "models": {
        "qwen": {
          "name": "qwen",
          "limit": {
            "context": 98304,
            "output": 8192
          },
          "tools": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-pty",
    "@tarquinen/opencode-dcp",
    "opencode-websearch-cited",
    "opencode-mem",
    "@ramtinj95/opencode-tokenscope"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".next/**",
      ".nuxt/**",
      "coverage/**",
      "logs/**",
      "*.log",
      "*.lock",
      "*.min.js",
      "*.map",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.webp",
      "*.gif",
      "*.ico",
      "*.pdf",
      "*.zip",
      "*.rar",
      "*.7z"
    ]
  },
  "mcp": {
    "repomix": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "/opt/jupyter:/workspace",
        "ghcr.io/yamadashy/repomix",
        "--mcp",
        "--config",
        "/workspace/.opencode/repomix.config.json"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "serena": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "-v",
        "/opt/jupyter:/workspaces/projects/disbral-beatriz-margem",
        "-v",
        "/root/.serena/serena_config.yml:/root/.serena/serena_config.yml:ro",
        "ghcr.io/oraios/serena:latest",
        "serena",
        "start-mcp-server",
        "--context=ide",
        "--project",
        "/workspaces/projects/disbral-beatriz-margem"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "protheus": {
      "type": "local",
      "command": [
        "python3",
        "/opt/jupyter/.opencode/mcp_protheus.py"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "task": "allow",
    "doom_loop": "allow",
    "question": "allow",
    "external_directory": "allow"
  }
}