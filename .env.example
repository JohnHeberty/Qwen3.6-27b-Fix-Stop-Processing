# ── Ornith-1.0-35B Q4_K_M via llama-server ───────────────────────────────────
# RTX 3090 (24 GB). Pesos ~21 GB. KV q8_0.
# Contexto maximo: 131072 tokens (128k).
# 13/13 testes OK (tool-calling, reasoning, streaming).
# Benchmark: 127 tok/s @8k, 114 tok/s @24k

# Modelo (ja baixado — nao precisa de HF_TOKEN)
MODEL_DIR=/root/qwen3/data/models/Ornith-1.0-35B-Q4_K_M
MODEL_FILE=Ornith-1.0-35B-UD-Q4_K_M.gguf

# Nome exposto na API
SERVED_NAME=ornith
PORT=8080

# ── Contexto e KV cache ──────────────────────────────────────────────────────
N_CTX=131072
N_BATCH=4096
N_PARALLEL=1

# KV cache em q8_0 (quantizado — economiza VRAM p/ modelo maior Q4_K_M)
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# Controle de RAM
CTX_CHECKPOINTS=16
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# ── GPU ──────────────────────────────────────────────────────────────────────
N_GPU_LAYERS=999

# ── Speculative Decoding ─────────────────────────────────────────────────────
ENABLE_MTP=false
DRAFT_ENABLED=false

# ── Sampling (defaults Ornith/reasoning) ─────────────────────────────────────
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0
REPEAT_PENALTY=1.0
REPEAT_LAST_N=64
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=1.5
SEED=-1
N_PREDICT=16384

# ── Reasoning ────────────────────────────────────────────────────────────────
REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=2048
REASONING_BUDGET_MESSAGE=

# ── DRY sampler (anti-loop) ──────────────────────────────────────────────────
DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=2048

# ── Template ─────────────────────────────────────────────────────────────────
TEMPLATE_FILE=data/templates/custom/chat_template_local.jinja
ERROR_WARNINGS=true

# ── Outros ───────────────────────────────────────────────────────────────────
NO_MMAP=1
CAPTURE_LOG=false
LOG_RETENTION_DAYS=7
