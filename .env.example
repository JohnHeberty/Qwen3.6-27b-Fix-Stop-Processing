# Credenciais (obrigatório — obtenha em https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo GGUF
MODEL_HF=unsloth/Qwen3.6-27B-MTP-GGUF
MODEL_FILE=Qwen3.6-27B-Q5_K_M.gguf

# Template — baixado automaticamente do HuggingFace (froggeric/Qwen-Fixed-Chat-Templates)
# TEMPLATE_HF_REPO: repositório onde o template é mantido (sempre a versão mais recente)
# TEMPLATE_FILE: aponta para o arquivo raiz do repo (chat_template.jinja é sempre o latest)
# Para atualizar manualmente: make update-template
TEMPLATE_HF_REPO=froggeric/Qwen-Fixed-Chat-Templates
TEMPLATE_FILE=data/templates/chat_template.jinja

# llama.cpp (compilação e binário — ajuste se instalar em outro diretório)
LLAMA_CPP_DIR=/root/llama.cpp
LLAMA_SERVER=/root/llama.cpp/build/bin/llama-server

# CUDA (ajuste se instalado em outro caminho)
CUDA_HOME=/usr/local/cuda

# Servidor
PORT=8000
SERVED_NAME=qwen3
N_GPU_LAYERS=-1
N_CTX=65536
N_BATCH=4096
N_PARALLEL=1
NO_MMAP=1

# ── Quantização do KV Cache ───────────────────────────────────────────────────
# Controla a precisão do cache de chave/valor. Menor precisão = menos VRAM = mais contexto.
# Opções: f32, f16 (padrão), bf16, q8_0, q5_1, q5_0, q4_1, q4_0, iq4_nl
# Recomendado: q8_0 (reduz ~50% VRAM vs f16, perda mínima de qualidade)

# Tipo de quantização para a chave (K)
CACHE_TYPE_K=q8_0

# Tipo de quantização para o valor (V)
CACHE_TYPE_V=q8_0

# ── Controle de RAM (prevenção OOM em LXC/Proxmox) ────────────────────────────
# O llama-server salva checkpoints do prompt cache em RAM. Com prompts longos
# (70k+ tokens), isso pode consumir 4-5GB e causar OOM em containers.

# Número de checkpoints de contexto em RAM (default llama.cpp: 32).
#   8  = equilibrado (recomendado para RTX 3090 com 65536 contexto)  ← padrão
#   16 = mais performance (se tiver RAM sobrando)
#   32 = padrão llama.cpp (pode causar OOM com prompts longos)
CTX_CHECKPOINTS=8

# RAM alocada para cache em MiB (0 = desativado, usa apenas VRAM).
#   2048 = 2GB para cache em RAM (bom equilíbrio)  ← padrão
#   4096 = 4GB (mais performance, exige RAM disponível)
#   0    = desativado (se VRAM for suficiente)
CACHE_RAM=2048

# Manter slots de cache ociosos (1 = ativo, 0 = desativado).
#   1 = mantém cache para requisições subsequentes (mais rápido)  ← padrão
#   0 = desativado (libera RAM imediatamente)
CACHE_IDLE_SLOTS=1

# ── Amostragem — equivalente ao PARAMETER do Modelfile Ollama ────────────────
# Esses valores controlam "como" o modelo gera texto.
# Para coding, menor temperatura + top_k baixo = resposta mais precisa e focada.

# Temperatura: controla criatividade/foco.
#   0.1–0.4  = muito determinístico (bom para código repetitivo, testes)
#   0.6      = recomendado pelo Qwen3 para thinking mode + coding  ← padrão
#   0.8–1.0  = mais criativo (bom para prosa, brainstorming)
TEMPERATURE=0.6

# Top-K: limita a escolha aos K tokens mais prováveis a cada passo.
#   20  = foco alto (coding)  ← padrão
#   40  = equilíbrio
#   0   = desativado (usa apenas top_p/min_p)
TOP_K=20

# Top-P (nucleus sampling): mantém tokens que somam P de probabilidade.
#   0.95 = recomendado pelo Qwen3 thinking mode  ← padrão
#   0.9  = ligeiramente mais conservador
TOP_P=0.95

# Min-P: descarta tokens com probabilidade < MIN_P × prob_do_top_token.
#   Elimina tokens muito improváveis sem cortar a diversidade saudável.
#   0.05 = corta tokens com < 5% da prob do token mais provável  ← padrão
#   0.0  = desativado
MIN_P=0.05

# Penalidade de repetição: pune tokens que já apareceram recentemente.
#   Reduz loops e caracteres estranhos (ex.: japonês/chinês no código).
#   1.0  = desativado
#   1.05 = penalidade leve  ← padrão
#   1.1  = penalidade moderada
#   1.2+ = penalidade forte (pode degradar qualidade)
REPEAT_PENALTY=1.05

# Janela de tokens para repeat_penalty (últimos N tokens avaliados).
REPEAT_LAST_N=64

# Frequency penalty: penalidade proporcional à frequência do token.
#   0.1 = leve redução de tokens muito repetidos  ← padrão
#   0.0 = desativado
FREQUENCY_PENALTY=0.1

# Presence penalty: penalidade binária para qualquer token já usado.
#   0.0 = desativado  ← padrão
PRESENCE_PENALTY=0.0

# Seed de aleatoriedade (-1 = aleatório a cada chamada).
#   Qualquer inteiro positivo = resposta reproduzível (útil para testes).
SEED=-1

# Máximo de tokens a gerar por resposta.
#   4096 = limita saídas longas (recomendado para estabilidade)  ← padrão
#   8192 = para respostas mais longas
#   -1   = ilimitado (pode causar geração infinita)
N_PREDICT=4096
