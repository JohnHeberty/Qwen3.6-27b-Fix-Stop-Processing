# Credenciais (obrigatório — obtenha em https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo GGUF
MODEL_HF=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf

# Template (nossa versão: froggeric v21.3 + error_warnings off por padrão — carregado em
# runtime via --chat-template-file). O froggeric puro fica em custom/chat_template_v21.jinja.
TEMPLATE_FILE=data/templates/custom/chat_template_local.jinja

# Heurística de detecção de erro do template: ao ver "error:/failed to/traceback…" no
# começo de uma resposta de ferramenta, injeta um ⚠️ SYSTEM WARNING e, após 2 falhas,
# desliga o thinking. Desligada por padrão porque dá falsos positivos (grep achando
# "error", teste imprimindo "0 errors", git status…) que fazem o modelo abandonar um
# caminho correto. true = reativa o comportamento antigo.
ERROR_WARNINGS=true

# Captura de conteúdo para depuração (DEFAULT off). true = grava prompt renderizado
# (data/logs/capture/prompts/) + geração token-a-token (data/logs/capture/llama-verbose.log).
# Volumoso — ligue só numa janela de debug. Use `make capture-on` / `make capture-off`.
CAPTURE_LOG=false
# Limite de tamanho (MB) da pasta de prompts de captura. Monitor em background remove
# pastas de data mais antigas ao ultrapassar. Desativado se não definido.
CAPTURE_MAX_MB=500

# Limpeza de logs (dias — usado por make clean-logs e make cron-clean-logs)
LOG_RETENTION_DAYS=7

# llama.cpp (compilação e binário — ajuste se instalar em outro diretório)
LLAMA_CPP_DIR=/root/llama.cpp
LLAMA_SERVER=/root/llama.cpp/build/bin/llama-server

# CUDA (ajuste se instalado em outro caminho)
CUDA_HOME=/usr/local/cuda

# Servidor
PORT=8000
SERVED_NAME=qwen3
N_GPU_LAYERS=-1
N_CTX=106496
N_BATCH=4096
N_PARALLEL=1
NO_MMAP=1

# ── Speculative Decoding (MTP) ───────────────────────────────────────────────
# Multi-Token Prediction: modelo prevê N tokens por passo usando heads internos.
# Requer modelo com MTP heads (ex.: unsloth/Qwen3.6-35B-A3B-MTP-GGUF).
#   true  = habilita draft-mtp (ganho de 30-80% em tok/s, depende da aceitação)
#   false = desabilitado
ENABLE_MTP=true
# Número de tokens draftados por step. O GGUF só tem 1 MTP head embutida
# (qwen35moe.nextn_predict_layers=1), mas o llama.cpp consegue draftar de
# forma recursiva com esse head — n>1 continua funcionando e ainda ajuda.
#   2 = ótimo benchmarkado (142.7 tok/s @ 8k, 71.6% aceitação)  ← padrão
#   1 = mais conservador (133.3 tok/s, 78.1% aceitação)
#   3+ = aceitação cai (54% em n=3, 35% em n=6), throughput piora
MTP_TOKENS=2

# ── Quantização do KV Cache ───────────────────────────────────────────────────
# Controla a precisão do cache de chave/valor. Menor precisão = menos VRAM = mais contexto.
# Opções: f32, f16 (padrão), bf16, q8_0, q5_1, q5_0, q4_1, q4_0, iq4_nl
# Recomendado: q4_0 no 35B-A3B (mais rápido E maior teto de contexto que q8_0/q5_1
# nesse modelo especificamente — ver docs/infra/reports/35b-a3b/). Requer llama.cpp
# compilado com GGML_CUDA_FA_ALL_QUANTS=ON (make build-llama-server já aplica).

# Tipo de quantização para a chave (K)
CACHE_TYPE_K=q4_0

# Tipo de quantização para o valor (V)
CACHE_TYPE_V=q4_0

# ── Controle de RAM (prevenção OOM em LXC/Proxmox) ────────────────────────────
# O llama-server salva checkpoints do prompt cache em RAM. Com prompts longos
# (70k+ tokens), isso pode consumir 4-5GB e causar OOM em containers.

# Número de checkpoints de contexto em RAM (default llama.cpp: 32).
#   8  = equilibrado (recomendado para RTX 3090 com 80k contexto)
#   16 = mais performance (se tiver RAM sobrando)  ← padrão
#   32 = padrão llama.cpp (pode causar OOM com prompts longos)
CTX_CHECKPOINTS=16

# RAM alocada para cache em MiB (0 = desativado, usa apenas VRAM).
#   2048 = 2GB para cache em RAM (bom equilíbrio)
#   4096 = 4GB (mais performance, exige RAM disponível)  ← padrão
#   0    = desativado (se VRAM for suficiente)
CACHE_RAM=4096

# Manter slots de cache ociosos (1 = ativo, 0 = desativado).
#   1 = mantém cache para requisições subsequentes (mais rápido)  ← padrão
#   0 = desativado (libera RAM imediatamente)
CACHE_IDLE_SLOTS=1

# ── Amostragem — equivalente ao PARAMETER do Modelfile Ollama ────────────────
# Esses valores controlam "como" o modelo gera texto.
# Para coding, menor temperatura + top_k baixo = resposta mais precisa e focada.

# Valores oficiais recomendados pelo Qwen para tarefas de código/tool-calling
# (temp=0.6, top_k=20, top_p=0.95, min_p=0, sem penalidades). Penalidades fortes
# atrapalham repetições legítimas de nomes de props, caminhos, símbolos e params.

# Temperatura: controla criatividade/foco.
#   0.1–0.4  = muito determinístico (bom para código repetitivo, testes)
#   0.6      = recomendado pelo Qwen3 para thinking mode + coding  ← padrão
#   0.8–1.0  = mais criativo (bom para prosa, brainstorming)
TEMPERATURE=0.6

# Top-K: limita a escolha aos K tokens mais prováveis a cada passo.
#   20  = foco alto (coding, recomendado pelo Qwen)  ← padrão
#   40  = equilíbrio
#   0   = desativado (usa apenas top_p/min_p)
TOP_K=20

# Top-P (nucleus sampling): mantém tokens que somam P de probabilidade.
#   0.95 = recomendado pelo Qwen3 thinking mode  ← padrão
#   0.9  = ligeiramente mais conservador
TOP_P=0.95

# Min-P: descarta tokens com probabilidade < MIN_P × prob_do_top_token.
#   Elimina tokens muito improváveis sem cortar a diversidade saudável.
#   0.05 = corta tokens com < 5% da prob do token mais provável
#   0.0  = desativado (recomendado pelo Qwen)  ← padrão
MIN_P=0.0

# Penalidade de repetição: pune tokens que já apareceram recentemente.
#   Reduz loops e caracteres estranhos (ex.: japonês/chinês no código), mas
#   penaliza repetições legítimas em código/JSON — o Qwen recomenda desligar.
#   1.0  = desativado (recomendado pelo Qwen)  ← padrão
#   1.05 = penalidade leve
#   1.1  = penalidade moderada
#   1.15 = penalidade moderada-alta
#   1.2+ = penalidade forte (pode degradar qualidade)
REPEAT_PENALTY=1.03

# Janela de tokens para repeat_penalty (últimos N tokens avaliados).
REPEAT_LAST_N=64

# Frequency penalty: penalidade proporcional à frequência do token.
#   0.0 = desativado (recomendado pelo Qwen para código)  ← padrão
#   0.1 = leve redução de tokens muito repetidos
#   0.2 = redução moderada
FREQUENCY_PENALTY=0.0

# Presence penalty: penalidade binária para qualquer token já usado.
#   Qwen recomenda 0.0, mas com 0.0 há risco de loop de repetição em uso agêntico longo
#   (geração até o teto de tokens). 0.1 freia o loop com pouco impacto na qualidade.
#   0.0 = desativado (recomendação Qwen)
#   0.1 = penalidade leve (anti-loop)  ← padrão
PRESENCE_PENALTY=0.1

# DRY sampler — anti-loop PRINCIPAL (o presence_penalty leve NÃO segura loop de bloco longo).
# DRY penaliza sequências longas repetidas verbatim (loop de raciocínio/geração), sem punir
# repetição legítima de código. multiplier=0 desliga.
DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=2048

# Seed de aleatoriedade (-1 = aleatório a cada chamada).
#   Qualquer inteiro positivo = resposta reproduzível (útil para testes).
SEED=-1

# Máximo de tokens a gerar por resposta.
#   4096 = limita saídas longas
#   8192 = para respostas mais longas  ← padrão
#   -1   = ilimitado (pode causar geração infinita)
N_PREDICT=8192

# ── Reasoning budget: teto de tokens de PENSAMENTO (dentro do bloco <think>) ──
# Ao atingir o teto, o llama.cpp fecha o </think> e FORÇA o modelo a responder/agir.
# É o fix do "thought-loop" do Qwen3.6 (ele repete o mesmo parágrafo dentro do raciocínio
# até estourar o N_PREDICT). Corta SÓ o raciocínio descontrolado — NÃO reduz o contexto
# (segue 104k) e NÃO quebra tool-calling (ao contrário do DRY, que truncava caminhos).
#
# Como escolher (mexa aqui e reinicie: `make restart` ou `systemctl restart qwen-server`):
#   -1   = ilimitado (desliga o corte — volta a arriscar o loop)
#   1024 = agressivo: corta cedo. Use se AINDA pintar loop de raciocínio.
#   2048 = equilíbrio  ← padrão (raciocínio real converge < ~1700; loop é cortado em 2048)
#   3072–4096 = folgado: se notar que ele "pensa pouco" em problemas difíceis (corte cedo demais)
# Regra prática: raciocínio legítimo converge sozinho. Pensamento repetitivo -> ABAIXE.
# Respostas rasas em tarefa complexa -> SUBA.
REASONING_BUDGET=2048
