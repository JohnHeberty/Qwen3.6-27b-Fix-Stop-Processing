[Unit]
Description=llama-server — Qwen3.6 GGUF (35B-A3B default) Server (porta 8000)
After=network-online.target
Wants=network-online.target
# Independente do Ollama.
#
# Este arquivo e um TEMPLATE: os marcadores __PROJECT_ROOT__ sao substituidos pelo
# caminho real do repo por `make install-service` (portavel entre VMs/diretorios).
# Nao instale este arquivo direto — use `make install-service`.

[Service]
Type=simple
User=root
Group=root

# PATH precisa incluir venv e cuda para o systemd encontrar os binarios.
Environment="PATH=__PROJECT_ROOT__/.venv/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin"

# start-server.sh ja carrega o .env (source) — nao precisa EnvironmentFile.
WorkingDirectory=__PROJECT_ROOT__
ExecStart=/bin/bash __PROJECT_ROOT__/scripts/start-server.sh

# Auto-recuperacao: reinicia SEMPRE (inclusive apos OOM-kill).
# RestartSec=20 da tempo da VRAM da instancia anterior liberar antes de recarregar
# o modelo (senao o restart pode falhar por falta de VRAM = crash-loop).
Restart=always
RestartSec=20
# Nao derruba a unit por eventos de OOM do cgroup — deixa o Restart cuidar.
OOMPolicy=continue

# Logs persistentes (o diretorio e criado por make install-service).
StandardOutput=append:__PROJECT_ROOT__/data/logs/server.log
StandardError=append:__PROJECT_ROOT__/data/logs/server.log

# Modelo GGUF leva ~30-90s para carregar.
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
