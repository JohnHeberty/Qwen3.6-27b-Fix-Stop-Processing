{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "model": "vllm/qwen3.8-27b",
    "small_model": "vllm/qwen3.8-27b",
    "default_agent": "orchestrator",
    "provider": {
        "vllm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Qwen3.8-27B AutoRound+DFlash2 (vLLM)",
            "options": {
                "baseURL": "http://192.168.1.139:18020/v1"
            },
            "models": {
                "qwen3.8-27b": {
                    "name": "Qwen3.8-27B AutoRound+DFlash2 (vLLM TP=2, 130k)",
                    "limit": {
                        "context": 130000,
                        "output": 16384
                    },
                    "tools": true,
                    "reasoning": true,
                    "interleaved": {
                        "field": "reasoning_content"
                    }
                }
            }
        }
    },
    "plugin": [
        "opencode-pty",
        "@tarquinen/opencode-dcp",
        "opencode-websearch-cited",
        "opencode-mem",
        "@ramtinj95/opencode-tokenscope",
        "opencode-reflection",
        "@dv.nghiem/flowdeck"
    ],
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 8192
    },
    "watcher": {
        "ignore": [
            "node_modules/**",
            "vendor/**",
            "dist/**",
            "build/**",
            ".git/**",
            ".next/**",
            ".nuxt/**",
            "coverage/**",
            "logs/**",
            "*.log",
            "*.lock",
            "*.min.js",
            "*.map",
            "*.png",
            "*.jpg",
            "*.jpeg",
            "*.webp",
            "*.gif",
            "*.ico",
            "*.pdf",
            "*.zip",
            "*.rar",
            "*.7z"
        ]
    },
    "mcp": {
        "repomix": {
            "type": "local",
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "-v",
                "/opt/jupyter:/workspace",
                "ghcr.io/yamadashy/repomix",
                "--mcp",
                "--config",
                "/workspace/.opencode/repomix.config.json"
            ],
            "enabled": false,
            "timeout": 60000
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": false,
            "timeout": 30000
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest",
                "--headless"
            ],
            "enabled": false,
            "timeout": 120000
        }
    },
    "skills": {
        "paths": [
            ".opencode/skills"
        ]
    },
    "instructions": [
        "AGENTS.md"
    ],
    "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "lsp": "allow",
        "task": "allow",
        "doom_loop": "allow",
        "question": "allow",
        "external_directory": "allow"
    }
}
