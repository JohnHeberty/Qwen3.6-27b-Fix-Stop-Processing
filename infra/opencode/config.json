{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "llama/qwen3.6-27b",
  "small_model": "llama/qwen3.6-27b",
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.6-27B Q4_K_M+MTP (llama.cpp)",
      "options": {
        "baseURL": "http://192.168.1.139:8080/v1"
      },
      "models": {
        "qwen3.6-27b": {
          "name": "Qwen3.6-27B Q4_K_M+MTP (llama.cpp, 262k)",
          "limit": {
            "context": 196608,
            "output": 65536
          },
          "reasoning": true,
          "vision": false,
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "qwen3-vl-4b-vision": {
          "name": "Qwen3-VL 4B Q4+Vision (llama.cpp, 32k)",
          "limit": {
            "context": 28672,
            "output": 4096
          },
          "reasoning": false,
          "vision": true,
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-pty",
    "@tarquinen/opencode-dcp",
    "opencode-websearch-cited",
    "opencode-mem",
    "@ramtinj95/opencode-tokenscope",
    "opencode-reflection"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 65536
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".next/**",
      ".nuxt/**",
      "coverage/**",
      "logs/**",
      "*.log",
      "*.lock",
      "*.min.js",
      "*.map",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.webp",
      "*.gif",
      "*.ico",
      "*.pdf",
      "*.zip",
      "*.rar",
      "*.7z"
    ]
  },
  "mcp": {
    "repomix": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "/opt/jupyter:/workspace",
        "ghcr.io/yamadashy/repomix",
        "--mcp",
        "--config",
        "/workspace/.opencode/repomix.config.json"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "task": "allow",
    "doom_loop": "allow",
    "question": "allow",
    "external_directory": "allow"
  }
}