{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qwen-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ornith 35B (llama.cpp)",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "nao-precisa"
      },
      "models": {
        "ornith": {
          "name": "Ornith-35B IQ4_XS (llama.cpp)",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" }
        }
      }
    }
  },
  "plugin": [
    "opencode-pty",
    "@tarquinen/opencode-dcp",
    "opencode-websearch-cited",
    "opencode-mem",
    "@ramtinj95/opencode-tokenscope",
    "opencode-reflection"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".next/**",
      ".nuxt/**",
      "coverage/**",
      "logs/**",
      "*.log",
      "*.lock",
      "*.min.js",
      "*.map",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.webp",
      "*.gif",
      "*.ico",
      "*.pdf",
      "*.zip",
      "*.rar",
      "*.7z"
    ]
  },
  "mcp": {
    "repomix": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "/opt/jupyter:/workspace",
        "ghcr.io/yamadashy/repomix",
        "--mcp",
        "--config",
        "/workspace/.opencode/repomix.config.json"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "task": "allow",
    "doom_loop": "allow",
    "question": "allow",
    "external_directory": "allow"
  },
  "model": "qwen-local/ornith",
  "small_model": "qwen-local/ornith"
}