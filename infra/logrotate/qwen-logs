# logrotate para os logs do qwen (vLLM DFlash2).
# TEMPLATE: __PROJECT_ROOT__ é substituído por `make install-logrotate`.
# Instala em /etc/logrotate.d/qwen-logs.
__PROJECT_ROOT__/data/logs/vllm-dflash2.log
{
    daily
    rotate 7
    maxsize 200M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}