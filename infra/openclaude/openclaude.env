# OpenClaude -> servidor local Qwen3.8-27B (vLLM 0.31, porta 18020)
#
# Este e o caminho OFICIALMENTE documentado para apontar o OpenClaude a um
# endpoint OpenAI-compativel. Use com:
#     openclaude --provider-env-file /caminho/para/openclaude.env
# ou exporte as variaveis antes de chamar `openclaude` (o OpenClaude NAO le
# arquivos .env do projeto automaticamente).
#
# Alternativa sem arquivo: rode `/provider` dentro do OpenClaude e preencha
# os mesmos tres valores; ele salva um perfil em .openclaude-profile.json.

CLAUDE_CODE_USE_OPENAI=1
OPENAI_BASE_URL=http://192.168.1.139:18020/v1
OPENAI_MODEL=qwen3.8-27b

# O servidor roda SEM autenticacao, mas o cliente exige a variavel presente.
# Qualquer valor serve; ele e ignorado pelo vLLM.
OPENAI_API_KEY=vllm-local-sem-auth

# Limites do servidor (max_model_len=142080). Sobrescrevem o modelLimits do
# settings.json e evitam que o cliente assuma um catalogo errado.
# As aspas simples sao OBRIGATORIAS: sem elas o shell remove as aspas duplas
# do JSON ao exportar e o cliente recebe algo que nao parseia (testado).
CLAUDE_CODE_OPENAI_CONTEXT_WINDOWS='{"qwen3.8-27b":140000}'
CLAUDE_CODE_OPENAI_MAX_OUTPUT_TOKENS='{"qwen3.8-27b":32768}'
