{
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "model": {
        "primary": "litellm/qwen"
      },
      "models": {
        "litellm/qwen": {}
      },
      "thinkingDefault": "medium",
      "compaction": {
        "reserveTokensFloor": 12288,
        "reserveTokens": 12288,
        "midTurnPrecheck": {
          "enabled": true
        },
        "timeoutSeconds": 1200,
        "notifyUser": true,
        "memoryFlush": {
          "softThresholdTokens": 20000
        },
        "mode": "safeguard",
        "keepRecentTokens": 8000,
        "truncateAfterCompaction": true
      },
      "memorySearch": {
        "enabled": true,
        "provider": "openai-compatible",
        "model": "qwen3-embedding:0.6b-cpu-smart",
        "fallback": "none",
        "remote": {
          "baseUrl": "http://100.91.54.69:4000/v1/",
          "apiKey": "${LITELLM_API_KEY}"
        }
      },
      "contextLimits": {
        "toolResultMaxChars": 16000
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1m",
        "hardClear": {
          "enabled": true,
          "placeholder": "[Old tool result removed to preserve context]"
        }
      },
      "timeoutSeconds": 1800,
      "runRetries": {
        "max": 10
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding",
    "loopDetection": {
      "enabled": true
    },
    "web": {
      "search": {
        "provider": "duckduckgo",
        "enabled": true
      }
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "byProvider": {
      "litellm": {}
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      },
      "litellm": {
        "enabled": true
