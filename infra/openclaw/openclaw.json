  "models": {
    "mode": "merge",
    "providers": {
      "litellm": {
        "baseUrl": "http://100.91.54.69:4000",
        "api": "openai-completions",
        "apiKey": "${LITELLM_API_KEY}",
        "timeoutSeconds": 1200,
        "request": {
          "allowPrivateNetwork": true
        },
        "models": [
          {
            "id": "qwen",
            "name": "Qwen 3.6 27B INT4 (vLLM)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 49152,
            "maxTokens": 8192,
            "compat": {
              "supportsReasoningEffort": false,
              "supportsUsageInStreaming": true,
              "supportsTools": true,
              "supportsStrictMode": false,
              "requiresStringContent": true,
              "strictMessageKeys": false
            },
            "api": "openai-completions",
            "contextTokens": 49152
          }
        ]
      }
    }
  },
