# ── Qwen3.8-27B UD-Q4_K_XL — 2× RTX 3090 / 2 clientes ───────────────────────
# Perfil de producao: 524288 tokens totais, divididos em 2 slots de 262144.
# KV q8_0, MTP nativo n=3 e visao processada na CPU/RAM para preservar VRAM.

TEMPLATE_FILE=

# ── Modelo e rede ─────────────────────────────────────────────────────────────
MODEL_HF=unsloth/Qwen3.8-27B-GGUF
# Build b10502 otimizado localmente, unica versao mantida neste host.
LLAMA_CPP_DIR=/root/llama.cpp-b10502
LLAMA_BUILD_DIR=/root/llama.cpp-b10502/build-cuda
LLAMA_SERVER=/root/llama.cpp-b10502/build-cuda/bin/llama-server
LLAMA_CPP_COMMIT=0adcc3bb571011bff8b91335d0728a82845c421b
MODEL_DIR=/root/qwen3/data/models/Qwen3.8-27B-UD-Q4_K_XL
MODEL_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf
SERVED_NAME=qwen3.8-27b
PORT=8080
HOST=0.0.0.0
OLLAMA_PORT=11434

# ── Visao nativa ──────────────────────────────────────────────────────────────
# MMPROJ e relativo a MODEL_DIR. false mantém o projetor na CPU/RAM; apenas a
# codificacao da imagem usa CPU, enquanto o modelo textual continua nas GPUs.
# 2048 limita custo/detalhe por imagem; batch de 1024 limita picos de memoria.
MMPROJ=mmproj-F16.gguf
MMPROJ_OFFLOAD=false
IMAGE_MAX_TOKENS=2048
MTMD_BATCH_MAX_TOKENS=1024

# ── Contexto e cache ──────────────────────────────────────────────────────────
# N_CTX e total: N_PARALLEL=2 entrega 262144 tokens a cada cliente.
N_CTX=524288
N_PREDICT=65536
# A/B no b10502: 4096 melhorou o prefill em 5,0% contra 2048, sem diferenca
# relevante no stream ou na aceitacao MTP. Microbatch fisico permanece em 512.
N_BATCH=4096
N_PARALLEL=2
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CTX_CHECKPOINTS=8

# Teto evictavel do cache de prompts na RAM. 5120 MiB deixa margem para o
# mmproj, buffers da CPU e sistema numa maquina de 32 GiB sem swap.
CACHE_RAM=5120
CACHE_IDLE_SLOTS=1

# ── GPUs e MTP ────────────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0,1
N_GPU_LAYERS=999

# layer e o modo seguro com draft-mtp neste modelo. TENSOR_SPLIT distribui a
# carga para equilibrar a VRAM observada nas duas RTX 3090.
SPLIT_MODE=layer
TENSOR_SPLIT=0.55,0.45
ENABLE_MTP=true
# Medicao local com temp=0.3: n=2/p_min=0.5 = 82.9% de aceitacao e 60.62 tok/s.
# n=3/p_min=0 = 65.9% e 60.35 tok/s. p_min=0.8 passa de 90%, mas fica mais lento.
# O limiar evita tentar drafts de baixa confianca; ajuste pelo tok/s, nao so pelo %.
MTP_TOKENS=2
MTP_P_MIN=0.5
DRAFT_ENABLED=false
DRAFT_MODEL_FILE=
DRAFT_N_MAX=5

# ── CPU, kernels, memoria e observabilidade ──────────────────────────────────
# Threads de CPU da geracao e do processamento de prompts/lotes. Este host
# disponibiliza 8 CPUs ao processo.
THREADS=8
THREADS_BATCH=8

# Forca Flash Attention na GPU para reduzir trafego de memoria no contexto longo.
# Valores aceitos pelo llama.cpp: on, off ou auto.
FLASH_ATTN=on

# Move os samplers para o backend/acelerador. Recurso experimental do llama.cpp.
BACKEND_SAMPLING=true

# false evita descartar tokens antigos silenciosamente quando a janela enche.
CONTEXT_SHIFT=false

# true mapeia o GGUF pelo sistema operacional e permite reaproveitar page cache.
# Esta variavel substitui o NO_MMAP legado.
MMAP=true

# Habilita o endpoint Prometheus GET /metrics na mesma porta do servidor.
METRICS=true

# ── WebUI e sampling ──────────────────────────────────────────────────────────
WEBUI=true
# Deve acompanhar BACKEND_SAMPLING para a WebUI nao sobrescrever o default.
WEBUI_CONFIG='{"backend_sampling": true}'

TEMPERATURE=0.3
TOP_K=20
TOP_P=0.95
MIN_P=0.0
REPEAT_PENALTY=1.0
REPEAT_LAST_N=256
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
SEED=-1

# ── Reasoning ─────────────────────────────────────────────────────────────────
REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=8192
REASONING_BUDGET_MESSAGE="Stop analyzing. Choose the safest minimal change, execute it now, and run the smallest relevant test."
REASONING_PRESERVE=true
REASONING_EFFORT=low
ERROR_WARNINGS=false

# ── Anti-loop e logs ──────────────────────────────────────────────────────────
DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=8192
CAPTURE_LOG=false
LOG_RETENTION_DAYS=7
