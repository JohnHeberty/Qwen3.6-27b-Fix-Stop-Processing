# Qwen3.8-27B Frozenlock AutoRound INT4 + z-lab DFlash2, vLLM TP=2.
VLLM_ROOT=/root/qwen3/qwen38-27b-rtx3090
TARGET_MODEL=/root/qwen3/qwen38-27b-rtx3090/models/Qwen3.8-27B-int4-AutoRound-Frozenlock
DRAFT_MODEL=/root/qwen3/qwen38-27b-rtx3090/models/Qwen3.8-27B-DFlash2-zlab
SERVED_NAME=qwen3.8-27b
HOST=0.0.0.0
PORT=8080

# 96k e o maximo validado com margem no vLLM 0.27.1 desta maquina.
MAX_MODEL_LEN=96000
GPU_MEMORY_UTILIZATION=0.95
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1600
DFLASH_DRAFT_TOKENS=7

# Defaults do chat; clientes podem sobrescrever por requisicao.
DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":true,"reasoning_effort":"low","preserve_thinking":false}'
GENERATION_CONFIG='{"temperature":0.6,"top_p":0.95,"top_k":20,"min_p":0.0,"repetition_penalty":1.0}'

CUDA_TOOLKIT=/usr/local/cuda-12.8
CUDA_PY_ROOT=/root/qwen3/qwen38-27b-rtx3090/venv/lib/python3.12/site-packages/nvidia/cu13
VLLM_DFLASH2_LOOKUP=0
