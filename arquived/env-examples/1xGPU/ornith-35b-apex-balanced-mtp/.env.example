# ═══════════════════════════════════════════════════════════════════════════
# Ornith 1.0 35B — APEX-I-Balanced + MTP — 2× RTX 3090 (48 GB) — 131k ctx
# ═══════════════════════════════════════════════════════════════════════════
# Modelo MoE (3B ativos), APEX-I-Balanced (~24.2GB) + MTP graft.
# APEX: MoE-aware mixed-precision — beats Q8_0 perplexity at half size.
# Requer llama.cpp b9859+ (Qwen3.5 arch + draft-mtp).
# Vision: mmproj-F16.gguf incluído (858MB).
# ═══════════════════════════════════════════════════════════════════════════

HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

MODEL_HF=SC117/Ornith-1.0-35B-MTP-APEX-GGUF
MODEL_FILE=Ornith-1.0-35B-MTP-APEX-I-Balanced.gguf

TEMPLATE_FILE=
ERROR_WARNINGS=false
CAPTURE_LOG=false
LOG_RETENTION_DAYS=7

LLAMA_CPP_DIR=/root/llama.cpp-b10502
LLAMA_SERVER=/root/llama.cpp-b10502/build-cuda/bin/llama-server
CUDA_HOME=/usr/local/cuda

PORT=8080
HOST=0.0.0.0
OLLAMA_PORT=11434
SERVED_NAME=ornith-35b-apex
N_GPU_LAYERS=999
N_CTX=131072
N_PREDICT=16384
N_BATCH=4096
N_PARALLEL=1
NO_MMAP=1

# KV q8_0 — modelo 24.2GB + KV 131k q8_0 ~1.3GB + MTP ~1.5GB ≈ 27GB / 48GB (folga)
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# MTP graft do Qwen3.6-35B-A3B (self-speculative decode)
ENABLE_MTP=true
MTP_TOKENS=2
DRAFT_ENABLED=false

CTX_CHECKPOINTS=8
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# Params oficiais Ornith/APEX: temp=0.6, top_p=0.95, top_k=20
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0

REPEAT_PENALTY=1.05
REPEAT_LAST_N=256
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
SEED=-1

REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=8192
REASONING_BUDGET_MESSAGE=

DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=2048

# ── Vision Server ──────────────────────────────────────────
VISION_ENABLED=false
VISION_PORT=8081
VISION_MODEL_DIR=
VISION_MODEL_FILE=
VISION_MMPROJ=
VISION_CTX=32768
VISION_N_PREDICT=4096
