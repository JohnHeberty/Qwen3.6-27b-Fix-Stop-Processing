[Unit]
Description=vLLM Qwen3.8-27B AutoRound + DFlash2 TP=2 (porta 8080)
After=network-online.target
Wants=network-online.target
Conflicts=qwen-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/qwen3
ExecStart=/bin/bash /root/qwen3/scripts/start-vllm-dflash2.sh
Restart=always
RestartSec=20
KillMode=mixed
TimeoutStartSec=600
TimeoutStopSec=45
OOMPolicy=continue
StandardOutput=append:/root/qwen3/data/logs/vllm-dflash2.log
StandardError=append:/root/qwen3/data/logs/vllm-dflash2.log

[Install]
WantedBy=multi-user.target
