# ═══════════════════════════════════════════════════════════════════════════
# Qwen3.6-35B-A3B — Q8_K_XL — 2× RTX 3090 (48 GB) — 256k ctx
# ═══════════════════════════════════════════════════════════════════════════
# Modelo MoE (3B ativos), Q8_K_XL (39.1GB). 2 GPUs: split automático.
# MTP heads presentes no GGUF (nextn tensors). KV q8_0 cabe folgado.
# ═══════════════════════════════════════════════════════════════════════════

HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

MODEL_HF=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf

TEMPLATE_FILE=data/templates/qwen/chat_template_local.jinja
ERROR_WARNINGS=true
CAPTURE_LOG=false
CAPTURE_MAX_MB=500
LOG_RETENTION_DAYS=7

LLAMA_CPP_DIR=/root/llama.cpp
LLAMA_SERVER=/root/llama.cpp/build/bin/llama-server
CUDA_HOME=/usr/local/cuda

PORT=8080
SERVED_NAME=ornith
N_GPU_LAYERS=999
N_CTX=262144
N_PREDICT=65536
N_BATCH=4096
N_PARALLEL=1
NO_MMAP=1

# KV q8_0 — modelo 39.1GB + KV 262k q8_0 ~2.6GB ≈ 45GB / 48GB (4GB folga)
# f16 OOM: 24.124 MiB / 24.576 em cada placa (testado, não cabe)
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# MTP: Q8_K_XL tem tensores nextn (confirmado no log de load)
#   2 = benchmark repo: 142.7 tok/s @ 8k, 71.6% aceitação
ENABLE_MTP=true
MTP_TOKENS=2

CTX_CHECKPOINTS=8
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# Params oficiais: temp=0.6, top_p=0.95, top_k=20 (Ornith/Qwen3.6-Thinking)
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0

REPEAT_PENALTY=1.0
REPEAT_LAST_N=64
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=1.5

DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=2048

SEED=-1

REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=2048
REASONING_BUDGET_MESSAGE=