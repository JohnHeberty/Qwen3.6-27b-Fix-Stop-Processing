# ── Qwen3.8-27B Q8_0 via llama-server ────────────────────────────────────────
# 2× RTX 3090 (48 GB). Contexto 262144. Output 65536. KV cache: q8_0.
# Template: embutido no GGUF (qwen35 hybrid — Gated DeltaNet + Attention).
# MTP: draft-mtp com n=3 (MTP nativo do modelo).
# Vision: via mmproj-F16.gguf (o encoder NAO esta dentro do GGUF principal).
#
# ORCAMENTO DE VRAM — numeros medidos, nao estimados (llama_kv_cache no log):
#   pesos Q8_0 .................... 27.05 GiB (arquivo anunciado como 29 GB decimais)
#   KV principal q8_0 @ 262144 .... 8704 MiB  (16 camadas de atencao, K 4352 + V 4352)
#   KV do MTP (1 camada, f16) ..... 1024 MiB
#   mmproj-F16 .................... ~0.9 GiB
#   + buffers CUDA / compute graph / DeltaNet state
#   TOTAL OBSERVADO: 21.0 GiB (GPU 0) + 23.0 GiB (GPU 1) = ~44 GiB de 48 GiB
#
# O KV f16 seria o DOBRO do q8_0 (~17 GiB) e nao fecha: por isso q8_0 aqui.
# Folga real e de ~4 GiB — nao suba N_CTX nem troque o KV sem medir de novo.
# ATENCAO: NAO usar UD-Q8_K_XL (31.5 GB) — nao cabe.
#
# Downloads necessarios:
#   https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
#   Qwen3.8-27B-Q8_0.gguf (29 GB) + mmproj-F16.gguf (~0.9 GB)
#
# Throughput medido: decode 24-34 tok/s conforme o contexto; prompt processing
# 1000-1350 tok/s em chunks de 4096 (prompts do agente chegam a ~135k tokens).
TEMPLATE_FILE=

# ── Modelo ────────────────────────────────────────────────
MODEL_DIR=/root/qwen3/data/models/Qwen3.8-27B-Q8
MODEL_FILE=Qwen3.8-27B-Q8_0.gguf
SERVED_NAME=qwen3.8-27b
PORT=8080
HOST=0.0.0.0
OLLAMA_PORT=11434

# Vision via mmproj-F16.gguf (~0.9 GiB, do mesmo repo do GGUF).
# CAMINHO RELATIVO A MODEL_DIR de proposito: o start-server.sh monta
# "$MODEL_DIR/$MMPROJ" e valida a existencia antes de passar --mmproj.
# Nao troque por caminho absoluto sem ajustar o script. Vazio = sem vision.
MMPROJ=mmproj-F16.gguf

# ── Contexto ──────────────────────────────────────────────
# ATENCAO: N_CTX e a janela TOTAL — prompt + historico + thinking + resposta
# dividem os mesmos 262144. N_PREDICT=65536 nao soma, e o teto da geracao
# DENTRO da janela; logo a entrada util maxima e 262144 - 65536 = 196608
# (e por isso que litellm/opencode declaram max_input_tokens=196608).
# Os tokens de <think> contam dentro da geracao: REASONING_BUDGET nao mexe
# em N_PREDICT, consome parte dele. O cliente pode reduzir N_PREDICT por
# requisicao via max_tokens (foi o que vimos: max_tokens=32000 do OpenCode).
N_CTX=262144
N_PREDICT=65536
N_BATCH=4096
N_PARALLEL=1

# KV cache q8_0 — Q8_0 28GB não cabe com f16 em 262k
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# CTX_CHECKPOINTS: checkpoints de contexto por slot. Default do upstream: 32 — 4 era
# conservador demais. Importa mais neste modelo que nos anteriores: as camadas Gated
# DeltaNet sao recorrentes (tem estado), e sem checkpoint suficiente um shift/reuso de
# contexto obriga reprocessar o prompt inteiro (a 600-715 tok/s, 118k tokens = ~3 min).
CTX_CHECKPOINTS=8

# CACHE_RAM (MiB): teto do cache de prompts em RAM do host. Default do upstream: 8192.
# Medido neste servidor: um state salvo vai de 96 MiB a 6414 MiB (mediana 2305 MiB).
# Com 2048 a maioria dos saves nao caberia e era descartada na hora — 90 eventos de
# "erasing old" no log. 4096 ainda ficaria abaixo dos states grandes de 262k, por isso
# vamos direto ao 8192 do upstream. E TETO de cache evictavel, nao reserva: o servidor
# despeja entradas antigas para respeitar o limite, entao nao pre-aloca 8 GB.
# Host tem 20 GB de RAM (~12 GB disponiveis). Se aparecer pressao de RAM/swap, 4096.
#
# DECISAO 2026-08-18: MANTER 8192, nao subir. Aparecem avisos do tipo
#   "prompt state size 12173 MiB exceeds cache size limit 8192.000 MiB, skipping"
# porque os prompts do agente chegam a ~135k tokens e o state passa de 12 GB. Cobrir
# isso exigiria CACHE_RAM>=12288, e a conta nao fecha:
#   - host tem 20 GB de RAM, ~14 GB disponiveis, e NENHUM SWAP configurado. Sem swap,
#     estourar nao degrada: o OOM killer mata o llama-server.
#   - o ganho e pequeno: apenas 22 eventos de "exceeds cache size limit" em todo o
#     trafego registrado.
#   - o caminho barato ja funciona: sim_best (reuso de prefixo no KV em VRAM) tem
#     mediana 0.997 e media 0.979 em 612 requisicoes, ou seja ~98% das requisicoes
#     reaproveitam o prefixo e nem dependem deste cache em RAM.
# Este cache e fallback para restaurar state apos evicao, nao o mecanismo principal.
# So reconsidere 12288 se houver swap configurado ou mais RAM no host.
CACHE_RAM=8192
CACHE_IDLE_SLOTS=1

# ── GPU ───────────────────────────────────────────────────
N_GPU_LAYERS=999

# MTP (Multi-Token Prediction) — nativo do Qwen3.8-27B.
# ENABLE_MTP e DRAFT_ENABLED sao INDEPENDENTES no start-server.sh, nao ha
# conflito: ENABLE_MTP=true ja emite "--spec-type draft-mtp --spec-draft-n-max N".
# DRAFT_ENABLED e so para draft model EXTERNO (outro GGUF), que nao usamos.
# Confirmado no processo em producao via /proc/<pid>/cmdline.
# n=3 e o default do proprio argumento do llama.cpp, nao uma recomendacao
# oficial do Qwen para este modelo — mantido por medicao, nao por doutrina.
#
# CUIDADO COM SPLIT_MODE: draft-mtp + "--split-mode tensor" travava a CUDA de
# forma reproduzivel no Qwen3.8-27B (llama.cpp issue 27122, aberto; n_max > 2
# acelera o travamento). O workaround e exatamente "--split-mode layer", que e
# o default e o que usamos explicitamente abaixo. Nao mude para tensor com MTP.
ENABLE_MTP=true
DRAFT_ENABLED=false
DRAFT_MODEL_FILE=
MTP_TOKENS=3

# SPLIT_MODE: none | layer | row | tensor. 'layer' e o default do llama.cpp e o
# unico seguro com MTP (ver acima). Explicito aqui para nao depender do default.
SPLIT_MODE=layer

# ── WebUI de chat ─────────────────────────────────────────
# O llama-server serve uma interface de chat (SvelteKit) na propria porta da API,
# em GET / — nao precisa instalar nada. true => --webui, false => --no-webui.
# Ligada por default no upstream; explicita aqui para nao depender disso.
#   http://localhost:8080   (e pelo IP da LAN, impresso no banner do start)
# Notas:
#  - usa o MESMO slot do agente (N_PARALLEL=1): um chat na UI espera na fila se
#    houver requisicao em voo. Foi o que ja causou 95s de wall-clock numa sonda
#    que o servidor atendeu em 2s.
#  - o painel de sampling da UI manda os valores no CORPO da requisicao, que
#    sobrescrevem o default do servidor — otimo para testar reasoning_effort,
#    enable_thinking e temperatura sem reiniciar nem tocar neste arquivo.
#  - a UI e servida so em gzip: curl sem --compressed recebe
#    "HTTP 415 Error: gzip is not supported by this browser". Navegador nao liga.
WEBUI=true

# WEBUI_CONFIG: defaults da UI, JSON (--webui-config). Vazio = omite a flag.
# CORRIGE UM BUG REAL DA WEBUI (llama.cpp issue 25605, build b865): o campo booleano
# "backend_sampling" e enviado pela UI SEM guarda de valor —
#     e.samplers&&(n.samplers=e.samplers), n.backend_sampling=e.backend_sampling
# (os vizinhos tem guarda, esse nao). Num perfil novo o valor e o placeholder de string
# vazia, entao a UI manda backend_sampling:"" e o servidor responde:
#     sem X-Conversation-Id -> HTTP 400 "type must be boolean, but is string"
#     com X-Conversation-Id -> HTTP 500 bad_function_call   <-- o que a UI sempre manda
# Resultado: TODA mensagem no chat da UI falha com 500 ate o valor ser definido.
# Fixar o default aqui resolve na origem. Semantica do campo (lido do bundle da UI):
#   label "Backend sampling", default false, "run samplers on the accelerator backend
#   for faster sampling" — e um toggle de performance, nao de qualidade.
# ASPAS SIMPLES obrigatorias: o JSON tem aspas duplas e espaco, e o script faz
# "set -a; source .env".
WEBUI_CONFIG='{"backend_sampling": false}'

# ── Sampling (Qwen3.8-27B OFFICIAL — thinking mode) ──────
# Fonte: https://huggingface.co/Qwen/Qwen3.8-27B (secao Best Practices), confirmado
# pela doc da Unsloth (https://unsloth.ai/docs/models/qwen3.8). Verificado 2026-08-17.
#
#   Thinking (o que usamos):  temp=1.0, top_p=0.95, top_k=20, min_p=0.0,
#                             presence_penalty=0.0, repetition_penalty=1.0
#   Non-thinking (instruct):  temp=0.7, top_p=0.80, top_k=20, min_p=0.0,
#                             presence_penalty=1.5, repetition_penalty=1.0
#
# NAO existe recomendacao oficial separada "thinking coding" para o 3.8 — o card
# dá só esses dois perfis. Os valores antigos daqui (temp=0.6 + presence=1.0) eram
# receita herdada do Qwen3.6 e estavam rotulados como "oficial" sem ser: temp abaixo
# do recomendado degrada o thinking, e presence_penalty>0 causa language mixing.
# Para coding/agentico o card recomenda o perfil thinking + output length generoso
# (ver N_PREDICT) + reasoning_effort controlado (ver REASONING_EFFORT abaixo).
#
# Se aparecer repeticao infinita: subir PRESENCE_PENALTY de 0.0 até no máximo 2.0
# (o card avisa que valor alto pode misturar idiomas e piorar um pouco a qualidade).
#
# VALORES OFICIAIS DO PERFIL THINKING, sem desvio (voltaram assim em 2026-08-18).
#
# Historico do desvio, para nao se repetir por engano: entre 2026-08-18 e a mesma data
# tentou-se temp 0.7 + top_p 0.80 (emprestados do perfil non-thinking, mas mantendo
# presence_penalty=0.0), com a hipotese de que menos aleatoriedade = menos tangentes no
# raciocinio. O experimento terminou SEM DADO: a medicao inicial que parecia mostrar
# ganho estava errada (usava n_decoded, que o llama.cpp loga a cada token, medindo
# progresso intermediario e nao total por requisicao) e, com a metrica correta
# (print_timing "eval time = X ms / N tokens"), o run de temp=0.7 tinha 2 requisicoes.
# Se quiser retomar, use scripts/compare-runs.sh e acumule trafego antes de concluir.
#
# O que NAO usar em thinking mode: o presence_penalty=1.5 do perfil instruct. Ele
# penaliza token ja visto, o que em coding atinge paths, identificadores e nomes de
# funcao (mesmo modo de falha do DRY, documentado aqui como "corrompe paths") e, num
# trace longo, empurra o modelo a introduzir material novo = divagar MAIS.
#
# ATENCAO — TOP_P AQUI NAO TEM EFEITO no trafego do agente: o cliente (OpenCode) manda
# top_p=1.0 no corpo da requisicao, e request-level vence o default do servidor.
# Confirmado em 2026-08-18 lendo GET /slots com uma requisicao real em voo. Os demais
# campos (temperature, top_k, min_p, presence, frequency, repeat) NAO sao enviados pelo
# cliente, entao esses o .env governa de fato. Para o top_p valer, tem de mudar no cliente.
TEMPERATURE=1.0
TOP_K=20
TOP_P=0.95
MIN_P=0.0

REPEAT_PENALTY=1.0
REPEAT_LAST_N=256
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
SEED=-1

# ── Reasoning ─────────────────────────────────────────────
# Qwen3.8-27B é reasoning model (hybrid thinking) — thinking ligado.
REASONING_MODE=on
REASONING_FORMAT=deepseek
# REASONING_BUDGET: teto de tokens DE PENSAMENTO (nao afeta N_PREDICT). Ao atingir, o
# llama.cpp fecha o </think> e forca o modelo a responder.
#
# 8192 — REVERTIDO de 4096 em 2026-08-17. O 4096 foi um erro: e GUILHOTINA, nao freio.
# Medido no trafego real: 90 de 674 requisicoes passaram de 4090 tokens gerados, isto e,
# queimaram o orcamento inteiro e foram cortadas no meio do raciocinio. Modelo cortado
# emite acao apressada — foi a causa do "pensa muito e executa mal".
# Quem deve encurtar o pensamento e REASONING_EFFORT (instrucao no prompt); o budget
# existe apenas como rede de seguranca contra thought-loop. Nao volte a apertar isso
# para reduzir verbosidade: aperte o effort.
REASONING_BUDGET=8192

# REASONING_BUDGET_MESSAGE: injetada ANTES do fecha-</think> quando o budget estoura.
# Sem ela o corte e seco e o modelo responde no vazio; com ela o corte fica ORIENTADO —
# em vez de "pare de pensar", diz o que fazer a seguir. Isso nao substitui o effort
# (quem encurta o pensamento e o REASONING_EFFORT); e a rede de seguranca ficando
# graciosa em vez de abrupta, e so dispara nas requisicoes que chegam aos 8192.
# AS QUOTES SAO OBRIGATORIAS: o start-server.sh faz "set -a; source .env", e valor com
# espacos sem quotes vira "command not found" no meio do load. O Makefile faz
# "-include .env" e trataria as quotes como literais, mas ele nunca le esta var.
REASONING_BUDGET_MESSAGE="Stop analyzing. Choose the safest minimal change, execute it now, and run the smallest relevant test."

# REASONING_PRESERVE — true | false | vazio (vazio = default do template).
# O template do Qwen3.8 tem preserve_thinking LIGADO por default: os blocos <think> das
# rodadas anteriores ficam no historico. Num loop de agente isso re-alimenta todo o
# pensamento acumulado a cada passo, inflando prompt e latencia progressivamente.
# false => --no-reasoning-preserve: mantem o raciocinio so na ultima mensagem do
# assistant. Recomendado para uso agentico; ligue de volta se algum cliente depender
# de ver o raciocinio das rodadas antigas.
REASONING_PRESERVE=true

# REASONING_EFFORT — valores VALIDOS: low | medium | xhigh (vazio = default do template).
# Lido direto do template embutido (GET /props):
#     resolved = reasoning_effort|default('xhigh')
#     if resolved == 'high': resolved = 'xhigh'            <- 'high' e ALIAS, nao nivel
#     if resolved not in ('xhigh','medium','low'): raise_exception(...)
# Ou seja: 'high' funciona mas nao e um nivel proprio (cai em xhigh), e qualquer
# outro valor faz o template levantar excecao — a requisicao falha, nao degrada.
#
# ATENCAO — o que cada valor REALMENTE injeta no system prompt (lido do template):
#   xhigh  -> "think carefully through the task, validate key assumptions, consider
#              plausible alternatives, prioritize correctness..."
#   medium -> NADA. Nao existe branch para 'medium' no template: reasoning_instructions
#             fica vazio. Nao e "esforco medio", e "sem nenhuma orientacao" — o modelo
#             usa a verbosidade natural dele.
#   low    -> "Keep your thinking brief and focused, moving directly to the conclusion
#              without unnecessary elaboration."
#
# 'low' e o UNICO valor que efetivamente pede pensamento curto, e por isso o escolhido
# para coding agentico. Historico: 'medium' foi usado de 2026-08-17 ate a mesma data na
# suposicao errada de que fosse um nivel intermediario; resultado observado foi pensar
# longo e bater no REASONING_BUDGET, que cortava o raciocinio e estragava a execucao.
#
# NOTA: nao existe flag --reasoning-effort no llama-server (build b865); o caminho
# e --chat-template-kwargs. O cliente pode sobrescrever por requisicao mandando
# chat_template_kwargs:{"reasoning_effort":"..."} (testado, funciona).
REASONING_EFFORT=xhigh

ERROR_WARNINGS=false

# ── DRY anti-loop ─────────────────────────────────────────
# Mantido desligado — NUNCA reativar para coding (corrompe paths)
DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=8192

# ── Vision Server (Qwen3-VL 4B) — OPCIONAL ───────────────
# Qwen3.8-27B TEM visão nativa — usa mmproj-F16.gguf do mesmo repo
# Esta seção é apenas como fallback com modelo separado
VISION_ENABLED=false
VISION_PORT=8081
VISION_MODEL_DIR=/root/qwen3/data/models/qwen3-vl-4b-vision
VISION_MODEL_FILE=Qwen3VL-4B-Instruct-Q4_K_M.gguf
VISION_MMPROJ=mmproj-Qwen3VL-4B-Instruct-F16.gguf
VISION_CTX=32768
VISION_N_PREDICT=4096

# ── Outros ────────────────────────────────────────────────
NO_MMAP=1
CAPTURE_LOG=false
LOG_RETENTION_DAYS=7
