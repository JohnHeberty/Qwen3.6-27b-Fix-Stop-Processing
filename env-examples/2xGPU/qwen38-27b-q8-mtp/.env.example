# ═══════════════════════════════════════════════════════════════════════════════
# Qwen3.8-27B Q8_0 + MTP — 2× RTX 3090 (48 GB)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Modelo dense 27B com:
#   - Arquitetura híbrida qwen35 (Gated DeltaNet + Attention)
#   - MTP nativo (draft-mtp, n=3)
#   - Visão nativa (vision encoder embutido — não precisa de modelo separado)
#   - Thinking mode por padrão
#   - 262K contexto nativo
#
# VRAM medida em producao: ~21.0GB (GPU 0) + ~23.1GB (GPU 1) de 24GB cada.
# Folga pequena — nao suba N_CTX nem troque o KV para f16 sem medir.
#
# Throughput medido (nao teorico): decode 36-40 tok/s em geracoes longas
# (6k-13k tokens de saida), prompt processing 600-715 tok/s.
#
# Downloads necessários:
#   https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
#   Arquivo: Qwen3.8-27B-Q8_0.gguf (29 GB)
#
# Sampling — o model card do Qwen3.8 da SO dois perfis (nao existe um de "coding"):
#
#   thinking (usado aqui):  temp=1.0, top_p=0.95, top_k=20, min_p=0.0,
#                           presence_penalty=0.0, repetition_penalty=1.0
#   nao-thinking (instruct): temp=0.7, top_p=0.80, top_k=20, min_p=0.0,
#                           presence_penalty=1.5, repetition_penalty=1.0
# ═══════════════════════════════════════════════════════════════════════════════

# Template: vazio = usa o template embutido no GGUF (recomendado para o 3.8).
TEMPLATE_FILE=

# ── Modelo ────────────────────────────────────────────────
MODEL_DIR=/root/qwen3/data/models/Qwen3.8-27B-Q8
MODEL_FILE=Qwen3.8-27B-Q8_0.gguf
SERVED_NAME=qwen3.8-27b
PORT=8080
HOST=0.0.0.0
OLLAMA_PORT=11434

# Vision nativa (mmproj-F16.gguf do mesmo repo)
MMPROJ=mmproj-F16.gguf

# ── Contexto ──────────────────────────────────────────────
N_CTX=262144
N_PREDICT=65536
N_BATCH=4096
N_PARALLEL=1

# KV cache q8_0 — f16 NAO cabe: Q8_0 (29GB) + KV f16 262k nao fecha em 48GB
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

CTX_CHECKPOINTS=4
CACHE_RAM=2048
CACHE_IDLE_SLOTS=1

# ── GPU ───────────────────────────────────────────────────
N_GPU_LAYERS=999

# MTP — nativo do modelo, n=3 para dense 27B
ENABLE_MTP=true
DRAFT_ENABLED=false
DRAFT_MODEL_FILE=
MTP_TOKENS=3

# ── Sampling (Qwen3.8-27B OFICIAL — perfil thinking) ──────
# Fonte: https://huggingface.co/Qwen/Qwen3.8-27B (Best Practices), confirmado pela
# doc da Unsloth (https://unsloth.ai/docs/models/qwen3.8). Verificado 2026-08-17.
# O card da APENAS dois perfis e NENHUM especifico de coding — para coding/agentico
# ele manda usar o perfil thinking + output generoso + reasoning_effort controlado.
TEMPERATURE=1.0
TOP_K=20
TOP_P=0.95
MIN_P=0.0

REPEAT_PENALTY=1.0
REPEAT_LAST_N=256
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
SEED=-1

# ── Reasoning ─────────────────────────────────────────────
REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=8192
REASONING_BUDGET_MESSAGE=

# REASONING_EFFORT — low | medium | high | xhigh (vazio = default do template).
# Novidade do 3.8: o template embutido le reasoning_effort como chat-template-kwarg
# e o default dele e "xhigh". 'medium' para coding agentico: xhigh gasta milhares de
# tokens de thinking por tool-call e a ~37 tok/s isso domina a latencia de cada passo.
REASONING_EFFORT=medium

ERROR_WARNINGS=false

# ── DRY anti-loop ─────────────────────────────────────────
DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=8192

# ── Vision — NATIVA (não precisa de modelo separado) ──────
VISION_ENABLED=false
VISION_PORT=8081
VISION_MODEL_DIR=/root/qwen3/data/models/qwen3-vl-4b-vision
VISION_MODEL_FILE=Qwen3VL-4B-Instruct-Q4_K_M.gguf
VISION_MMPROJ=mmproj-Qwen3VL-4B-Instruct-F16.gguf
VISION_CTX=32768
VISION_N_PREDICT=4096

# ── Outros ────────────────────────────────────────────────
NO_MMAP=1

# CAPTURE_LOG=true e o valor que esta em producao hoje, mas ATENCAO: e um switch de
# DEPURACAO. Ele liga --log-prompts-dir + --verbose, gravando o prompt renderizado de
# cada requisicao e cada token gerado. Custo real medido nesta maquina: 5.6 GB em
# data/logs/capture e server.log de ~0.5-1 GB por dia (comprimido).
# Para uso normal, deixe false e ligue sob demanda com `make capture-on`.
CAPTURE_LOG=true
LOG_RETENTION_DAYS=7
