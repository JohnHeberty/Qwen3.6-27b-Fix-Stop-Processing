# ═══════════════════════════════════════════════════════════════════════════
# Qwen3.6-27B — UD-Q8_K_XL (MTP) — 2× RTX 3090 (48 GB) — 256k ctx
# ═══════════════════════════════════════════════════════════════════════════
# Modelo DENSO 27B com MTP heads (unsloth). 35.8GB em 2 GPUs.
# Dense + MTP = ~29 tok/s (vs ~17 sem MTP). Mais lento que MoE A3B,
# mas melhor em benchmarks coding/terminal/reasoning.
# ═══════════════════════════════════════════════════════════════════════════

HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

MODEL_HF=unsloth/Qwen3.6-27B-MTP-GGUF
MODEL_FILE=Qwen3.6-27B-UD-Q8_K_XL.gguf

TEMPLATE_FILE=data/templates/qwen/chat_template_local.jinja
ERROR_WARNINGS=true
CAPTURE_LOG=false
CAPTURE_MAX_MB=500
LOG_RETENTION_DAYS=7

LLAMA_CPP_DIR=/root/llama.cpp
LLAMA_SERVER=/root/llama.cpp/build/bin/llama-server
CUDA_HOME=/usr/local/cuda

PORT=8080
SERVED_NAME=ornith
N_GPU_LAYERS=999
N_CTX=262144
N_PREDICT=65536
N_BATCH=4096
N_PARALLEL=1
NO_MMAP=1

# KV q8_0 — modelo 35.8GB + KV 262k q8_0 ~2.6GB + compute ~3GB ≈ 41.4GB / 48GB
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# MTP: unsloth Qwen3.6-27B-MTP-GGUF tem MTP heads (README: "1.5-2x faster")
ENABLE_MTP=true
MTP_TOKENS=2

CTX_CHECKPOINTS=8
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# Params oficiais Qwen3.6-Thinking: temp=0.6, top_p=0.95, top_k=20
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0

REPEAT_PENALTY=1.0
REPEAT_LAST_N=64
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=1.5

DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=2048

SEED=-1

REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=2048
REASONING_BUDGET_MESSAGE=