# ═══════════════════════════════════════════════════════════════════════════
# Ornith 35B — Q8_0 — 2× RTX 3090 (48 GB) — 256k ctx
# ═══════════════════════════════════════════════════════════════════════════
# Modelo oficial ornith-ai (36.9GB). 2 GPUs: split automático.
# Sem MTP heads (GGUF do ornith-ai não tem nextn tensors).
# Params oficiais: temp=0.6, top_p=0.95, top_k=20.
# ═══════════════════════════════════════════════════════════════════════════

HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

MODEL_HF=ornith-ai/Ornith-1.0-35B-GGUF
MODEL_FILE=ornith-1.0-35b-Q8_0.gguf

TEMPLATE_FILE=data/templates/qwen/chat_template_local.jinja
ERROR_WARNINGS=true
CAPTURE_LOG=false
CAPTURE_MAX_MB=500
LOG_RETENTION_DAYS=7

LLAMA_CPP_DIR=/root/llama.cpp
LLAMA_SERVER=/root/llama.cpp/build/bin/llama-server
CUDA_HOME=/usr/local/cuda

PORT=8080
SERVED_NAME=ornith
N_GPU_LAYERS=999
N_CTX=262144
N_PREDICT=65536
N_BATCH=4096
N_PARALLEL=1
NO_MMAP=1

# KV q8_0 — modelo 36.9GB + KV 262k q8_0 ~2.6GB + compute ~3GB ≈ 42.5GB / 48GB
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# Ornith Q8_0 oficial não tem MTP heads
ENABLE_MTP=false

CTX_CHECKPOINTS=8
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# Params oficiais Ornith: temp=0.6, top_p=0.95, top_k=20
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0

# Params oficiais Ornith: temp=0.6, top_p=0.95, top_k=20.
# Anti-loop: repeat 1.05, last_n 512, freq 0.3, presence 1.5.
REPEAT_PENALTY=1.01
REPEAT_LAST_N=64
FREQUENCY_PENALTY=0.1
PRESENCE_PENALTY=1.5

DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=2048

SEED=-1

REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=8192
REASONING_BUDGET_MESSAGE=