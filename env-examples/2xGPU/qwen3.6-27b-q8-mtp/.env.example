# ── Qwen3.6-27B Q8_XL + MTP via llama-server ──────────────────────────────
# 2× RTX 3090 (48 GB). Pesos ~34 GB (UD-Q8_K_XL).
# MTP: --spec-type draft-mtp (n_max=2), ~2.2GB VRAM extra.
# Contexto: 262144 (256k). Output: 16384 (16k). KV cache: q4_0.
# Template: chat_template_local.jinja (froggeric v21.x corrigida).
TEMPLATE_FILE=data/templates/qwen/chat_template_local.jinja

# ── Modelo ────────────────────────────────────────────────
MODEL_DIR=/root/qwen3/data/models/Qwen3.6-27B-Q8_XL
MODEL_FILE=Qwen3.6-27B-UD-Q8_K_XL.gguf
SERVED_NAME=ornith
PORT=8080
HOST=0.0.0.0
OLLAMA_PORT=11434

# ── Contexto ──────────────────────────────────────────────
N_CTX=262144
N_PREDICT=16384
N_BATCH=4096
N_PARALLEL=1

# KV cache q4_0 = menor footprint, permite contexto máximo em 48 GB
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0

CTX_CHECKPOINTS=8
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# ── GPU ───────────────────────────────────────────────────
N_GPU_LAYERS=999

# MTP (Multi-Token Prediction) — draft speculativo embutido no GGUF unsloth
# MTP_TOKENS=1 → ~33 tok/s, 96% acceptance, ~336MB livre GPU1
# MTP_TOKENS=2 → ~41 tok/s, 89% acceptance, ~264MB livre GPU1 (no limite)
ENABLE_MTP=true
MTP_TOKENS=2
DRAFT_ENABLED=false

# ── Sampling (Qwen3.6-27B — model card oficial) ────────────────────────
# Thinking coding: temp=0.6, top_p=0.95, top_k=20, min_p=0.0, presence=0.0
# Thinking general: temp=1.0, top_p=0.95 (mais criativo)
# Instruct: temp=0.7, top_p=0.8, presence=1.5 (NÃO usar com thinking)
# Usando thinking coding — otimizado pra agente/tool-calling.
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0

# Sem penalidades — oficial Qwen3.6 thinking mode
REPEAT_PENALTY=1.0
REPEAT_LAST_N=64
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
SEED=-1

# ── Reasoning ─────────────────────────────────────────────
# Qwen3.6-27B é reasoning model — thinking ligado.
REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=4096
REASONING_BUDGET_MESSAGE=

ERROR_WARNINGS=true

# ── DRY anti-loop ─────────────────────────────────────────
# 0 = desligado. NUNCA reativar para coding: penaliza a cópia
# verbatim de paths longos e trunca/corrompe caminhos de arquivo.
DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=8192

# ── Outros ────────────────────────────────────────────────
NO_MMAP=1
CAPTURE_LOG=true
LOG_RETENTION_DAYS=7
