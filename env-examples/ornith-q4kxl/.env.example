# ── Ornith-1.0-35B Q4_K_XL via llama-server ─────────────────────────────────
# RTX 3090 (24 GB). Pesos ~22.3 GB. KV f16.
# Contexto: 131072 (128k). Output: 32768 (32k).
# Template: embutido no GGUF (sem override — mais confiável para tool calling).
# Q4_K_XL: Q5/Q6 nos shared weights (attention, embeddings), experts Q4.

# ── Modelo ────────────────────────────────────────────────
MODEL_DIR=/root/qwen3/data/models/Ornith-1.0-35B-Q4_K_XL
MODEL_FILE=Ornith-1.0-35B-UD-Q4_K_XL.gguf
SERVED_NAME=ornith
PORT=8080
HOST=0.0.0.0
OLLAMA_PORT=11434

# ── Contexto ──────────────────────────────────────────────
N_CTX=131072
N_PREDICT=32768
N_BATCH=4096
N_PARALLEL=1

CACHE_TYPE_K=f16
CACHE_TYPE_V=f16

CTX_CHECKPOINTS=32
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# ── GPU ───────────────────────────────────────────────────
N_GPU_LAYERS=999

# Ornith não possui MTP funcional neste GGUF
ENABLE_MTP=false
DRAFT_ENABLED=false

# ── Sampling ──────────────────────────────────────────────
TEMPERATURE=0.6
TOP_K=20             # desabilitado — usa default do modelo
TOP_P=0.95
MIN_P=0.0

REPEAT_PENALTY=1.07
REPEAT_LAST_N=512

FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
SEED=-1

# ── Reasoning ─────────────────────────────────────────────
REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=2048
REASONING_BUDGET_MESSAGE=Stop reasoning now and provide the final answer.

# ── DRY anti-loop ─────────────────────────────────────────
# 0 = desligado. NUNCA reativar para coding: penaliza a cópia
# verbatim de paths longos e trunca/corrompe caminhos de arquivo.
DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=8192

# ── Outros ────────────────────────────────────────────────
NO_MMAP=1
CAPTURE_LOG=false
LOG_RETENTION_DAYS=7
