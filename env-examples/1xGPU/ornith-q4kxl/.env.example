# ═══════════════════════════════════════════════════════════════════════════
# Ornith 35B — Q4_K_XL — 1× RTX 3090 (24 GB) — 131k ctx
# ═══════════════════════════════════════════════════════════════════════════
# Modelo MoE (3B ativos), Q4_K_XL (22.9GB). Cabe em 1 GPU com KV f16.
# Params oficiais Ornith: temp=0.6, top_p=0.95, top_k=20.
# ═══════════════════════════════════════════════════════════════════════════

HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

MODEL_HF=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf

TEMPLATE_FILE=data/templates/qwen/chat_template_local.jinja
ERROR_WARNINGS=true
CAPTURE_LOG=false
CAPTURE_MAX_MB=500
LOG_RETENTION_DAYS=7

LLAMA_CPP_DIR=/root/llama.cpp
LLAMA_SERVER=/root/llama.cpp/build/bin/llama-server
CUDA_HOME=/usr/local/cuda

PORT=8080
SERVED_NAME=ornith
N_GPU_LAYERS=999
N_CTX=131072
N_PREDICT=16384
N_BATCH=4096
N_PARALLEL=1
NO_MMAP=1

# KV f16 — modelo Q4 (22.9GB) + KV f16 131k (~2GB) ≈ 25GB / 24GB (apertado mas cabe)
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16

# Ornith Q4_K_XL não tem tensores nextn (MTP heads) neste GGUF
ENABLE_MTP=false

CTX_CHECKPOINTS=16
CACHE_RAM=4096
CACHE_IDLE_SLOTS=1

# Params oficiais Ornith: temp=0.6, top_p=0.95, top_k=20.
# Anti-loop: repeat 1.05, last_n 512, freq 0.3, presence 1.5.
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0

REPEAT_PENALTY=1.03
REPEAT_LAST_N=64
FREQUENCY_PENALTY=0.1
PRESENCE_PENALTY=1.5

DRY_MULTIPLIER=0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=2048

SEED=-1

REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=8192
REASONING_BUDGET_MESSAGE=