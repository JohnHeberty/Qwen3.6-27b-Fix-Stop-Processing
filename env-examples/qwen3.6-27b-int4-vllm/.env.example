# ── Qwen3.6-27B INT4 (AutoRound) no vLLM ──────────────────────────────────────
# Avaliação em andamento: comparar com o baseline llama.cpp em docs/baseline-llamacpp.md
# (58,27 tok/s @8k · 55,95 tok/s @24k, 27B Q5_K_M + KV q4_0 + MTP n=2).

# Credenciais (só para baixar o modelo)
HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo. Este quant específico é obrigatório para o MTP: o AutoRound comum
# quantiza a camada `mtp.fc` junto e o speculative decoding para de funcionar.
# O Lorbus dequantiza essa camada de volta para BF16 (~100 MB).
MODEL_PATH=/root/qwen3/data/models-vllm/Qwen3.6-27B-int4-AutoRound

# Nome exposto na API. Mantido igual ao do llama.cpp para que LiteLLM, OpenCode
# e OpenClaw não precisem de nenhuma alteração ao trocar de engine.
SERVED_NAME=qwen3
PORT=8000

# ── Contexto e KV cache — o trade-off central nesta placa ─────────────────────
# A RTX 3090 é Ampere (sm_86) e NÃO tem hardware FP8, então o `fp8_e4m3` das
# receitas de referência não funciona aqui. Restam duas opções:
#
#   auto (fp16)        qualidade cheia, contexto limitado (~25-32k)
#   turboquant_3bit_nc 4.9x de compressão -> ~125k, MAS a doc do vLLM mede
#                      +20,6% de perplexidade e "queda relevante em raciocínio
#                      e contexto muito longo" — que é exatamente o uso agêntico
#
# Comece em `auto` para validar que a pilha sobe; troque depois para comparar.
KV_CACHE_DTYPE=auto
MAX_MODEL_LEN=32768

# Pesos INT4 ocupam ~19 GB dos 24 GB. Se der OOM na inicialização, baixe para
# 0.93. Se subir com `--enforce-eager` no log, o CUDA graph não coube: é o modo
# de falha que derruba para ~18 tok/s — reduza MAX_MODEL_LEN em vez de aceitar.
GPU_MEM_UTIL=0.95

# Uso single-user, equivalente ao N_PARALLEL=1 do llama.cpp.
MAX_NUM_SEQS=1
MAX_BATCHED_TOKENS=4128

# MTP — a receita de referência usa n=3 com 91-97% de aceitação.
ENABLE_MTP=true
MTP_TOKENS=3

# ── Contratos que os clientes dependem ────────────────────────────────────────
# reasoning-parser: equivalente ao `--reasoning-format deepseek` do llama.cpp.
#   Sem ele o `message.reasoning_content` fica vazio e o OpenClaw/OpenCode
#   param de mostrar o raciocínio.
REASONING_PARSER=qwen3
# tool-call-parser: sem ele a tool call sai como texto cru e o cliente não
#   enxerga ferramenta nenhuma sendo chamada.
TOOL_CALL_PARSER=hermes
