# ── Ornith-1.0-35B Q4_K_M via llama-server ───────────────────────────────────
# RTX 3090 (24 GB). Pesos ~21 GB. KV f16.
# Contexto: 131072 (128k). Output: 16384 (16k).
# Template: Qwen3.6 canônico (ornith-fixed.jinja) com last_query_index guard.

# ── Modelo ────────────────────────────────────────────────
MODEL_DIR=/root/qwen3/data/models/Ornith-1.0-35B-Q4_K_M
MODEL_FILE=Ornith-1.0-35B-UD-Q4_K_M.gguf
SERVED_NAME=ornith
PORT=8080
HOST=0.0.0.0
OLLAMA_PORT=11434

# ── Template corrigido ────────────────────────────────────
TEMPLATE_FILE=data/templates/custom/ornith-fixed.jinja

# ── Contexto ──────────────────────────────────────────────
N_CTX=131072
N_PREDICT=16384
N_BATCH=4096
N_PARALLEL=1

CACHE_TYPE_K=f16
CACHE_TYPE_V=f16

CTX_CHECKPOINTS=32
CACHE_RAM=16384
CACHE_IDLE_SLOTS=1

# ── GPU ───────────────────────────────────────────────────
N_GPU_LAYERS=999

# Ornith não possui MTP funcional neste GGUF
ENABLE_MTP=false
DRAFT_ENABLED=false

# ── Sampling Ornith ───────────────────────────────────────
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0

# Proteção moderada contra repetição
REPEAT_PENALTY=1.08
REPEAT_LAST_N=4096

FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
SEED=-1

# ── Reasoning ─────────────────────────────────────────────
REASONING_MODE=on
REASONING_FORMAT=deepseek
REASONING_BUDGET=4096
REASONING_BUDGET_MESSAGE=Stop reasoning now. Call the required tool or provide one final answer. Do not announce what you will do.

# ── DRY anti-loop ─────────────────────────────────────────
DRY_MULTIPLIER=0.5
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=4
DRY_PENALTY_LAST_N=4096

# ── Outros ────────────────────────────────────────────────
NO_MMAP=1
CAPTURE_LOG=false
LOG_RETENTION_DAYS=7
