{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "websearch": "deny",
    "webfetch": "deny"
  },
  "provider": {
    "lora": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM LoRA (teste, porta 18021)",
      "options": {
        "baseURL": "http://127.0.0.1:18021/v1",
        "apiKey": "dummy"
      },
      "models": {
        "opencode-adapted": {
          "name": "Qwen3.8-27B + opencode-adapted (LoRA, thinking off)",
          "tool_call": true,
          "reasoning": false,
          "temperature": true,
          "limit": {
            "context": 100000,
            "output": 16384
          },
          "options": {
            "temperature": 0.8,
            "top_p": 1.0,
            "presence_penalty": 0.0,
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B base (thinking off, mesma amostragem — braço de controle)",
          "tool_call": true,
          "reasoning": false,
          "temperature": true,
          "limit": {
            "context": 100000,
            "output": 16384
          },
          "options": {
            "temperature": 0.8,
            "top_p": 1.0,
            "presence_penalty": 0.0,
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    }
  },
  "model": "lora/opencode-adapted"
}
