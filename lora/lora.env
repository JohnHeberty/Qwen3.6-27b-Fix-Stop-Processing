# ============================================================================
# Instância de TESTE do adaptador LoRA harness-hub/Qwen3.8-27B-opencode-adapted
# ============================================================================
# Lido por lora/start_lora.sh DEPOIS de /root/qwen3/.env (que só é lido, nunca
# alterado). Tudo o que não está aqui vem da produção: SPEC=dflash2, DFLASH_TOKENS=7,
# DFLASH_MAX_LEN=142080, PREFIX_CACHE=1, HOST, QWEN_DEFAULT_* (patch local) etc.
# Formato: KEY=valor, sem `export`; o script faz `set -a`.

# ----------------------------------------------------------------------------
# Modelo base: o MESMO da produção (variante base, lm_head/MTP INT8), explícito.
# O .env da produção já fixa MODEL= desde 2026-11-19; repetido aqui para o teste não
# mudar de base se a produção voltar para a -fast (lm_head INT4, que travou mais em loop
# no A/B de scripts/loop_stress.py). select_model.sh respeita MODEL explícito.
# ----------------------------------------------------------------------------
MODEL=/root/qwen3/qwen38-27b-rtx3090/models/Qwen3.8-27B-W4A16-AutoRound

# ----------------------------------------------------------------------------
# Porta e log (a produção fica em 18020)
# ----------------------------------------------------------------------------
PORT=18021
# Só localhost: a instância é de teste e não tem API key. Os clientes da LAN não
# devem achar este servidor por engano. (Override: HOST=0.0.0.0 na linha de comando.)
HOST=127.0.0.1
LORA_LOG_DIR=/root/qwen3/lora/logs

# ----------------------------------------------------------------------------
# Adaptador
# ----------------------------------------------------------------------------
LORA_NAME=opencode-adapted
LORA_PATH=/root/qwen3/lora/adapters/opencode-adapted
# sha256 do LFS publicado no HF (commit b4171c0069685320026d76eac96ccf716ca7e476)
LORA_SHA256=668b9d7d4283d3d36622f0868c8d983a7299b4a37dbb393716d693dbb04f4582
LORA_SIZE=637610624

# ----------------------------------------------------------------------------
# Memória
# ----------------------------------------------------------------------------
# Produção (base INT8, desde 2026-11-19): GPU_UTIL=0.62 -> pool de KV de 5,22 GiB/GPU
# (152.271 tokens = só 1,07x o contexto de 142.080; boot de 2026-11-19 07:49).
# Custo estimado do LoRA por GPU (TP=2, r=32, bf16, --lora-target-modules restrito):
#   buffers A/B: gate_up+down x64 camadas + qkv+o x16 camadas = 100,7 M elems = 0,19 GiB
#     (lora/check_adapter.py calcula a partir do config.json)
#   + 2o conjunto de CUDA graphs (cudagraph_specialize_lora=True: com e sem LoRA) ~0,1 GiB
#   + metadados/scratch do punica (max-num-batched-tokens 2048)               < 0,05 GiB
#   total ~0,35 GiB/GPU, tirado do pool: 5,22 -> ~4,87 GiB (~142k tokens) = NO LIMITE do
#   max-model-len, e o vLLM recusa o boot se o pool não couber uma sequência inteira.
# 0,65 devolve ~0,72 GiB/GPU (24 GiB x 0,03) -> pool estimado ~5,6 GiB (~160k tokens).
# Durante a janela a produção está parada, então não há disputa de VRAM.
# Se mesmo assim o boot recusar o pool, use GPU_UTIL=0.67 na linha de comando.
GPU_UTIL=0.65

# ----------------------------------------------------------------------------
# EXTRA_ARGS: a produção inteira + flags de LoRA
# ----------------------------------------------------------------------------
# ARMADILHA (CLAUDE.md): o launcher expande ${EXTRA_ARGS} SEM aspas. Aspas simples em
# volta do VALOR INTEIRO; nada de aspas em volta do JSON; nenhum espaço dentro do JSON.
#
# Diferenças em relação ao EXTRA_ARGS da produção (o resto é idêntico):
#   --enable-lora --max-lora-rank 32 --max-loras 1 --max-cpu-loras 1
#   --lora-modules ${LORA_NAME}=${LORA_PATH}  NÃO está aqui: start_lora.sh acrescenta a
#       partir das variáveis acima (o caminho não pode ter espaços). O nome base
#       qwen3.8-27b continua servido pelo --served-model-name do launcher.
#   --lora-target-modules qkv_proj o_proj gate_up_proj down_proj
#       Sem isto o vLLM 0.33 embrulha TODA camada linear suportada (lora/model_manager.py
#       _create_lora_modules com target_modules=None): projeções do DeltaNet
#       (in_proj_qkvz, in_proj_ba, out_proj), o lm_head INT8 compressed-tensors
#       (LogitsProcessorWithLoRA, e o DFlash2 compartilha esse lm_head) e o embed INT8. O adaptador não toca nada disso; restringir
#       economiza VRAM e evita caminhos de LoRA sobre camadas quantizadas exóticas.
#   (mantido) --enable-log-requests: o log mostra lora_request por request -> prova de
#       qual braço rodou com o adaptador.
EXTRA_ARGS='--tensor-parallel-size 2 --default-chat-template-kwargs {"reasoning_effort":"medium","enable_thinking":true,"preserve_thinking":false} --reasoning-effort-map {"high":"xhigh","max":"xhigh","minimal":"low"} --override-generation-config {"presence_penalty":1.0} --enable-log-requests --max-log-len 300 --enable-lora --max-lora-rank 32 --max-loras 1 --max-cpu-loras 1 --lora-target-modules qkv_proj o_proj gate_up_proj down_proj'

# Não mexer: DFLASH_TOKENS>7 liga o comprimento ADAPTATIVO do bloco de verify do DFlash2
# (single-user/start_qwen.sh, bloco do VLLM_DFLASH2_LOOKUP_ADAPTIVE). O vLLM recusa
# "adaptive verification" com LoRA porque o mapeamento token->LoRA é montado na CPU antes
# do corte do bloco (config/vllm.py:_validate_adaptive_verification). O caminho do
# HyperQwen não passa por essa checagem — então 15 drafts + LoRA é território não testado.
DFLASH_TOKENS=7
